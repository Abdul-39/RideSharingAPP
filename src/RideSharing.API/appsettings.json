{
  "Matching": {
    "RouteCorridorRadiusKm": 3,
    "TimeToleranceMinutes": 15,
    "MaxDestinationDistanceKm": 8
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=RideSharingDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "JwtSettings": {
    "Secret": "",
    "Issuer": "RideSharing.API",
    "Audience": "RideSharing.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },

  "GoogleMaps": {
    "ApiKey": ""
  },

  "FareSettings": {
    "BaseFare": 50,
    "PerKmRate": 15,
    "Currency": "PKR"
  },

  "RatingSettings": {
    "LowRatingThreshold": 2.5
  }
}