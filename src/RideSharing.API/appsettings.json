{
  "Matching": {
    "RouteCorridorRadiusKm": 5,
    "MaxDestinationDistanceKm": 12,
    "TimeToleranceMinutes": 15,
    "MaxDetourKm": 15,
    "MaxDetourPercentage": 50,
    "MinDirectionCosine": 0.2,
    "WeightCorridorProximity": 0.35,
    "WeightDestination": 0.2,
    "WeightTime": 0.2,
    "WeightVerification": 0.1,
    "WeightCapacity": 0.1,
    "WeightPreference": 0.05,
    "RequireVerifiedForWomenOnly": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=RideSharingDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "JwtSettings": {
    "Secret": "RideSharing_SuperSecret_Key_AtLeast32Chars_ChangeInProduction_2026!",
    "Issuer": "RideSharing.API",
    "Audience": "RideSharing.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },

  "GoogleMaps": {
    "ApiKey": ""
  },

  "FareSettings": {
    "BaseFare": 50,
    "PerKmRate": 15,
    "Currency": "PKR"
  },

  "RatingSettings": {
    "LowRatingThreshold": 2.5
  },
  "Payments": {
    "SimulationShowOtp": true,
    "JazzCash": {
      "MerchantId": "",
      "Password": ""
    },
    "EasyPaisa": {
      "StoreId": "",
      "HashKey": ""
    }
  }
}
